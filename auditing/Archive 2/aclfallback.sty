% ---------------------------------------------------------------------
%  aclfallback.sty -- replicates the ACL 2023+ page geometry and styling
%  so this document compiles without acl.sty.
%  ON OVERLEAF: delete \usepackage{aclfallback} from main.tex and use
%               \usepackage[final]{acl}  instead. Nothing else changes.
% ---------------------------------------------------------------------
\ProvidesPackage{aclfallback}
\RequirePackage{geometry}
\geometry{letterpaper,top=1in,bottom=1in,left=1in,right=1in,
          headheight=0pt,headsep=0pt,footskip=0.4in}
\setlength{\columnsep}{0.2in}
\RequirePackage{titlesec}
\titlespacing*{\section}{0pt}{1.4ex plus .2ex minus .2ex}{0.7ex plus .1ex}
\titlespacing*{\subsection}{0pt}{1.1ex plus .2ex minus .2ex}{0.5ex plus .1ex}
\titlespacing*{\subsubsection}{0pt}{0.9ex plus .2ex minus .2ex}{0.4ex plus .1ex}
\titlespacing*{\paragraph}{0pt}{0.7ex plus .1ex}{1em}
\titleformat{\section}{\normalfont\large\bfseries}{\thesection}{0.6em}{}
\titleformat{\subsection}{\normalfont\normalsize\bfseries}{\thesubsection}{0.6em}{}
\titleformat{\subsubsection}{\normalfont\normalsize\itshape}{\thesubsubsection}{0.6em}{}
\titleformat{\paragraph}[runin]{\normalfont\normalsize\itshape}{}{0pt}{}[.]
